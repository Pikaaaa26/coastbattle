# Coast Battle — environment variables (copy to .env for local overrides; Render sets these in its dashboard)

# Port the HTTP + WebSocket server listens on. Render injects this automatically; 8787 is the local default.
PORT=8787

# Where ratings.json + battle_logs/ are written. Point this at a mounted persistent disk on Render
# (paid plans) to keep the ELO leaderboard across deploys. Defaults to the app root (ephemeral).
# DATA_DIR=/var/data

# ONLY needed if you host the client on a DIFFERENT origin than the server. For the single-service
# deploy (server serves the client), leave this UNSET — the client auto-derives wss://<host>/ws.
# VITE_WS_URL=wss://your-app.onrender.com/ws
